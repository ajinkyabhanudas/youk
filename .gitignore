# Python
__pycache__/
*.py[cod]
*.pyo
.env
*.egg-info/
dist/
/build/
.venv/
venv/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/

# Docker
.dockerignore

# Runtime state (local only, not committed — state/.gitkeep IS committed for fresh clones)
state/*
!state/.gitkeep

# Generated dashboard reports (local only — regenerate with make report)
reports/

# Per-project session context (personal, local only — not shared across installs)
knowledge/projects/

# SQLite indexes — generated at runtime, never committed
knowledge/*.db

# Instance-local knowledge — personal intelligence, never universally applicable
# Capabilities (skills, server code) belong in the repo; accumulated knowledge does not
knowledge/proposals/
knowledge/global/
knowledge/imported/
knowledge/voice-corpus.jsonl
knowledge/corrections.jsonl
knowledge/domain/*
!knowledge/domain/.gitkeep
!knowledge/domain/reasoning-integrity.md
# Foundational architecture ADRs — youk's self-revision identity (committed, not instance-local)
!knowledge/domain/self-revision-meta-loop.md
!knowledge/domain/angle-basis-self-revision.md
!knowledge/domain/skill-trust-artifact.md
!knowledge/domain/operational-resilience.md
knowledge/user-profile.md

# Accumulated /learn domain knowledge — grows per-user, never shared across installs
skills/learn/knowledge/

# install.sh runtime symlinks (self-referential, machine-absolute paths — not portable)
skills/*/*
# Skill reference files and scripts are infrastructure, not accumulated knowledge — track them
!skills/*/references/
!skills/*/scripts/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Secrets
*.env
.env.*
*secret*
*credential*
*api_key*
